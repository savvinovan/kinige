{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-window",
  "description": "Окно быстрого захвата: только Inbox и свой черновик, без чтения ленты, настроек, ссылок и событий",
  "windows": ["capture"],
  "permissions": [
    "allow-capture-state",
    "allow-capture-send",

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-window",
  "description": "Quick capture window: only Inbox and its own draft, no reading of the feed, settings, links or events",
  "windows": ["capture"],
  "permissions": [
    "allow-capture-state",
    "allow-capture-send",
    "allow-capture-append",
    "allow-capture-save-draft",
    "allow-capture-hide",
    "allow-capture-resize",
    "allow-capture-add-recent-emoji"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Главное окно: свои команды без core:default, плюс подписка на событие «записи изменились»; без JS-разрешений плагинов opener, dialog и global-shortcut",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-get-language",
    "allow-list-chats",
    "allow-list-messages",
    "allow-send-message",
    "allow-get-settings",
    "allow-set-text-size",
    "allow-choose-mirror-folder",
    "allow-open-external-url",
    "allow-get-draft",
    "allow-save-draft",
    "allow-set-shortcut",
    "allow-reset-shortcut",
    "allow-shortcut-recording",
    "allow-create-chat",
    "allow-rename-chat",
    "allow-set-chat-icon",
    "allow-set-chat-pinned",
    "allow-set-chat-archived",
    "allow-delete-message",
    "allow-restore-message",
    "allow-edit-message",
    "allow-toggle-task-item",
    "allow-set-message-flag",
    "allow-set-message-date",
    "allow-list-trash",
    "allow-purge-message",
    "allow-set-sidebar-collapsed",
    "allow-add-recent-emoji",
    "allow-startup-state",
    "allow-restore-backup",
    "allow-restart-for-recovery",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

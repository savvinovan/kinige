{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Главное окно: только команды слайса 1, без core:default и без JS-разрешений плагинов opener и dialog",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-get-language",
    "allow-list-chats",
    "allow-list-messages",
    "allow-send-message",
    "allow-get-settings",
    "allow-set-text-size",
    "allow-choose-mirror-folder",
    "allow-open-external-url"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Главное окно: свои команды без core:default, плюс подписка на событие «записи изменились»; без JS-разрешений плагинов opener, dialog и global-shortcut",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-get-language",
    "allow-list-chats",
    "allow-list-messages",
    "allow-send-message",
    "allow-get-settings",
    "allow-set-text-size",
    "allow-choose-mirror-folder",
    "allow-open-external-url",
    "allow-get-draft",
    "allow-save-draft",
    "allow-set-shortcut",
    "allow-reset-shortcut",
    "allow-shortcut-recording",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window: its own commands without core:default, plus subscription to app events (\"entries changed\", \"open chat\", \"settings changed\", \"open entry\"); the \"On this day\" commands (slice 5) and the forest commands (slice 6); no JS permissions of the opener, dialog and global-shortcut plugins. The settings window commands are revoked from it (slice 4b)",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-get-language",
    "allow-list-chats",
    "allow-list-messages",
    "allow-send-message",
    "allow-get-settings",
    "allow-open-external-url",
    "allow-get-draft",
    "allow-save-draft",
    "allow-create-chat",
    "allow-rename-chat",
    "allow-set-chat-icon",
    "allow-set-chat-pinned",
    "allow-set-chat-archived",
    "allow-delete-message",
    "allow-restore-message",
    "allow-edit-message",
    "allow-toggle-task-item",
    "allow-set-message-flag",
    "allow-set-message-date",
    "allow-move-message",
    "allow-list-trash",
    "allow-purge-message",
    "allow-set-sidebar-collapsed",
    "allow-add-recent-emoji",
    "allow-startup-state",
    "allow-restore-backup",
    "allow-restart-for-recovery",
    "allow-import-telegram-open",
    "allow-import-telegram-run",
    "allow-import-telegram-stop",
    "allow-import-telegram-close",
    "allow-search-messages",
    "allow-open-settings",
    "allow-get-on-this-day",
    "allow-dismiss-on-this-day",
    "allow-get-forest-year",
    "allow-get-forest-day-target",
    "allow-set-forest-view",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

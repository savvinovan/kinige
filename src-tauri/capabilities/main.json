{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Главное окно: свои команды без core:default, плюс подписка на события приложения («записи изменились», «открыть чат», «настройки изменились», «открыть запись»); без JS-разрешений плагинов opener, dialog и global-shortcut. Команды окна настроек у него отозваны (слайс 4b)",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-get-language",
    "allow-list-chats",
    "allow-list-messages",
    "allow-send-message",
    "allow-get-settings",
    "allow-open-external-url",
    "allow-get-draft",
    "allow-save-draft",
    "allow-create-chat",
    "allow-rename-chat",
    "allow-set-chat-icon",
    "allow-set-chat-pinned",
    "allow-set-chat-archived",
    "allow-delete-message",
    "allow-restore-message",
    "allow-edit-message",
    "allow-toggle-task-item",
    "allow-set-message-flag",
    "allow-set-message-date",
    "allow-move-message",
    "allow-list-trash",
    "allow-purge-message",
    "allow-set-sidebar-collapsed",
    "allow-add-recent-emoji",
    "allow-startup-state",
    "allow-restore-backup",
    "allow-restart-for-recovery",
    "allow-import-telegram-open",
    "allow-import-telegram-run",
    "allow-import-telegram-stop",
    "allow-import-telegram-close",
    "allow-search-messages",
    "allow-open-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

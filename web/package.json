    "lint": "eslint .",
    "test": "vitest run",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build -o storybook-static",
    "test:visual": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "dompurify": "3.4.17",
    "emojibase-data": "17.0.0",
    "frimousse": "0.4.0",
    "i18next": "26.5.4",
    "lucide-react": "1.60.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "10.6.2",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "http-server": "14.1.1",
    "jsdom": "30.1.3",
    "storybook": "10.6.2",
    "style-dictionary": "5.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"

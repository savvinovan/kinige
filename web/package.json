{
  "name": "kinige-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "style-dictionary build --config ../design/style-dictionary.config.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc --noEmit && vite build",

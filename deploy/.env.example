# Copy to .env (docker compose reads it from this directory). Every value below is a placeholder: generate your own, keep the file private,
# never commit it. .env and secrets/ are in .gitignore.

# The password of the Postgres user `kinige`. Hex only, so that it can sit inside the database URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-the-output-of-openssl-rand-hex-24

# The server secret: 64 hex characters. It keys the salt returned for an unknown login (ADR-0001 §8.4); keep the same one when the
# server moves to another host.
#   openssl rand -hex 32
KINIGE_SERVER_SECRET=replace-with-the-output-of-openssl-rand-hex-32

# The name clients reach the server by. A public name with ports 80 and 443 open gets a Let's Encrypt certificate by itself.
# `localhost` gives Caddy's own local certificate, which is for trying the stack out.
KINIGE_DOMAIN=localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Server settings (defaults in the README). Backups are kept this many days and then rotated; a deleted blob stays in the store for
# this many days plus one interval between backups, so that every backup that can be restored finds its blobs.
KINIGE_BACKUP_RETENTION_DAYS=30
KINIGE_BACKUP_INTERVAL_HOURS=24
KINIGE_BLOB_QUOTA_GIB=10
KINIGE_LOG=info

# Optional: keep the blobs in an S3-compatible store instead of the volume. Leave KINIGE_S3_BUCKET empty for the volume.
KINIGE_S3_BUCKET=
KINIGE_S3_ENDPOINT=
KINIGE_S3_REGION=us-east-1
KINIGE_S3_ACCESS_KEY=
KINIGE_S3_SECRET_KEY=
# 1 only for a store on the same private network as the server (plain HTTP to it).
KINIGE_S3_ALLOW_HTTP=0

# Where the backups volume is called, if you want two stacks to share it (a restore into a new host or a drill).
BACKUPS_VOLUME=kinige_backups

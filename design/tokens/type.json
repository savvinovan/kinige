{
  "type": {
    "$description": "The typographic scale by roles, compact (density as in Telegram, ADR-0004). Sizes are in rem, where 1rem = the entry text size (font.root.default, 13 px), so 'large text' changes the whole density together. Line height is a unitless multiplier. The family is a font.family.* role (sans / mono), the real fonts are set by the active set (active.fontset). The px values are at a 13 px root.",
    "day": {
      "$description": "The day label (a 'pill' in the center of the feed): 11.7 px (D2: was 11.2).",
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "0.9rem" },
      "lineHeight": { "$type": "number", "$value": 1.3 },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.medium}" }
    },
    "h1": {
      "$description": "H1 heading in an entry: 16.8 px, not much larger than the text.",
      "family": { "$type": "fontFamily", "$value": "{font.family.sans}" },
      "size": { "$type": "dimension", "$value": "1.29rem" },
      "lineHeight": { "$type": "number", "$value": 1.3 },
      "weight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" }
    },

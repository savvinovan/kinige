{
  "palette": {
    "dusk": {
      "$type": "color",
      "$description": "Кандидат тёмной палитры. Сумерки: нейтрально-тёплый графит, светлый текст, приглушённый стальной синий акцент. Значения подобраны по контрасту (тест tokens.test.ts); выбор вкуса за пользователем.",
      "surface": {
        "background": {
          "$value": "#1a1817",
          "$description": "Фон окна и сайдбара вокруг ленты."
        },
        "paper": {
          "$value": "#232120",
          "$description": "«Бумага» ленты и поля ввода: чуть светлее фона."
        }
      },
      "text": {
        "primary": {
          "$value": "#eae4de",
          "$description": "Основной текст записей."
        },
        "secondary": {
          "$value": "#b9b1a9",
          "$description": "Вторичный текст: подписи, приглушённый синтаксис."
        },
        "tertiary": {
          "$value": "#a0978f",
          "$description": "Метаданные: время, счётчики, подсказки."
        }
      },
      "accent": {
        "default": {
          "$value": "#8aa2bf",
          "$description": "Приглушённый акцент: ссылки, выбранный пункт, курсор."
        }
      },
      "border": {
        "divider": {
          "$value": "#3a3634",
          "$description": "Тонкий разделитель дней и записей (декоративный, не граница элемента управления)."
        }
      },
      "highlight": {
        "background": {
          "$value": "#292e38",
          "$description": "Подсвеченная запись, выделение текста."
        }
      },
      "focus": {
        "ring": {
          "$value": "#a3bad6",
          "$description": "Кольцо фокуса с клавиатуры."
        }
      },
      "status": {
        "error": {
          "$value": "#e88f86",
          "$description": "Состояние «не отправилось» и ошибки (§1.2 п. 9)."
        }
      }
    }
  }
}

{
  "fontset": {
    "plex": {
      "$description": "Кандидат набора шрифтов. IBM Plex Serif + IBM Plex Sans + IBM Plex Mono. Serif и Mono — статические начертания; Sans — переменный (ось веса 100–700). Подробности и источники — web/src/ui/fonts/README.md.",
      "family": {
        "$type": "fontFamily",
        "serif": {
          "$value": [
            "IBM Plex Serif",
            "Georgia",
            "Times New Roman",
            "serif"
          ]
        },
        "sans": {
          "$value": [
            "IBM Plex Sans",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "sans-serif"
          ]
        },
        "mono": {
          "$value": [
            "IBM Plex Mono",
            "ui-monospace",
            "SF Mono",
            "Menlo",
            "Consolas",
            "monospace"
          ]
        }
      },
      "face": {
        "serif-regular": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Serif",
            "style": "normal",
            "weight": "400",
            "file": "fonts/ibm-plex-serif/IBMPlexSerif-Regular.woff2"
          }
        },
        "serif-italic": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Serif",
            "style": "italic",
            "weight": "400",
            "file": "fonts/ibm-plex-serif/IBMPlexSerif-Italic.woff2"
          }
        },
        "serif-semibold": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Serif",
            "style": "normal",
            "weight": "600",
            "file": "fonts/ibm-plex-serif/IBMPlexSerif-SemiBold.woff2"
          }
        },
        "serif-bold": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Serif",
            "style": "normal",
            "weight": "700",
            "file": "fonts/ibm-plex-serif/IBMPlexSerif-Bold.woff2"
          }
        },
        "sans-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Sans",
            "style": "normal",
            "weight": "100 700",
            "file": "fonts/ibm-plex-sans/IBMPlexSans-Variable.woff2"
          }
        },
        "mono-regular": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Mono",
            "style": "normal",
            "weight": "400",
            "file": "fonts/ibm-plex-mono/IBMPlexMono-Regular.woff2"
          }
        },
        "mono-bold": {
          "$type": "fontFace",
          "$value": {
            "family": "IBM Plex Mono",
            "style": "normal",
            "weight": "700",
            "file": "fonts/ibm-plex-mono/IBMPlexMono-Bold.woff2"
          }
        }
      }
    }
  }
}

{
  "fontset": {
    "literata": {
      "$description": "Выбранный набор шрифтов. Literata (книжная антиква, Google Play Books) + Inter + JetBrains Mono. Все три переменные: одна ось веса покрывает regular / semibold / bold. Подробности и источники — web/src/ui/fonts/README.md.",
      "family": {
        "$type": "fontFamily",
        "serif": {
          "$value": [
            "Literata",
            "Georgia",
            "Times New Roman",
            "serif"
          ]
        },
        "sans": {
          "$value": [
            "Inter",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "sans-serif"
          ]
        },
        "mono": {
          "$value": [
            "JetBrains Mono",
            "ui-monospace",
            "SF Mono",
            "Menlo",
            "Consolas",
            "monospace"
          ]
        },
        "emoji": {
          "$value": [
            "Apple Color Emoji",
            "Segoe UI Emoji",
            "Noto Color Emoji",
            "sans-serif"
          ],
          "$description": "ИСКЛЮЧЕНИЕ из правила «шрифты только встроенные»: эмодзи чатов рисует системный эмодзи-шрифт (цветные эмодзи не встраиваем). Это данные пользователя (chats.icon), а не декор; других системных шрифтов в интерфейсе нет. Проверяет fonts.test.ts."
        }
      },
      "face": {
        "serif-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Literata",
            "style": "normal",
            "weight": "200 900",
            "file": "fonts/literata/Literata-Variable.woff2"
          }
        },
        "serif-italic-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Literata",
            "style": "italic",
            "weight": "200 900",
            "file": "fonts/literata/Literata-Italic-Variable.woff2"
          }
        },
        "sans-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Inter",
            "style": "normal",
            "weight": "100 900",
            "file": "fonts/inter/Inter-Variable.woff2"
          }
        },
        "mono-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "JetBrains Mono",
            "style": "normal",
            "weight": "100 800",
            "file": "fonts/jetbrains-mono/JetBrainsMono-Variable.woff2"
          }
        }
      }
    }
  }
}

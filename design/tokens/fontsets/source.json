{
  "fontset": {
    "source": {
      "$description": "Кандидат набора шрифтов. Source Serif 4 + Source Sans 3 + Source Code Pro (семейство Adobe). Все три переменные. Подробности и источники — web/src/ui/fonts/README.md.",
      "family": {
        "$type": "fontFamily",
        "serif": {
          "$value": [
            "Source Serif 4",
            "Georgia",
            "Times New Roman",
            "serif"
          ]
        },
        "sans": {
          "$value": [
            "Source Sans 3",
            "-apple-system",
            "BlinkMacSystemFont",
            "Segoe UI",
            "sans-serif"
          ]
        },
        "mono": {
          "$value": [
            "Source Code Pro",
            "ui-monospace",
            "SF Mono",
            "Menlo",
            "Consolas",
            "monospace"
          ]
        }
      },
      "face": {
        "serif-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Source Serif 4",
            "style": "normal",
            "weight": "200 900",
            "file": "fonts/source-serif-4/SourceSerif4-Variable.woff2"
          }
        },
        "serif-italic-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Source Serif 4",
            "style": "italic",
            "weight": "200 900",
            "file": "fonts/source-serif-4/SourceSerif4-Italic-Variable.woff2"
          }
        },
        "sans-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Source Sans 3",
            "style": "normal",
            "weight": "200 900",
            "file": "fonts/source-sans-3/SourceSans3-Variable.woff2"
          }
        },
        "mono-variable": {
          "$type": "fontFace",
          "$value": {
            "family": "Source Code Pro",
            "style": "normal",
            "weight": "200 900",
            "file": "fonts/source-code-pro/SourceCodePro-Variable.woff2"
          }
        }
      }
    }
  }
}

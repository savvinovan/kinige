{
  "rule": "Toggling the Nth task item of an entry. An item is a line (after indentation and quote marks) with a list marker, a gap, `[ ]`, `[x]` or `[X]`, a gap and non-empty text; lines in fenced code do not count. An item already in the requested state, or no such item, is `task_item_stale`. Only the one character changes.",
  "rust": "kinige_domain::tasks::set_task_item; the code is StoreError::TaskItemStale",
  "mock": "web/src/api/mockTasks.ts toggleTaskItem",
  "cases": [
    { "body": "- [ ] a\n- [x] b", "index": 0, "checked": true, "expected": "- [x] a\n- [x] b" },
    { "body": "- [ ] a\n- [x] b", "index": 1, "checked": false, "expected": "- [ ] a\n- [ ] b" },
    { "body": "- [ ] a\n- [x] b", "index": 0, "checked": false, "error": "task_item_stale" },
    { "body": "- [ ] a\n- [x] b", "index": 1, "checked": true, "error": "task_item_stale" },
    { "body": "- [ ] a\n- [x] b", "index": 2, "checked": true, "error": "task_item_stale" },
    { "body": "no items here", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "- [X] a", "index": 0, "checked": false, "expected": "- [ ] a" },
    { "body": "1. [ ] one\n2) [X] two\n* [ ] three\n+ [ ] four", "index": 1, "checked": false, "expected": "1. [ ] one\n2) [ ] two\n* [ ] three\n+ [ ] four" },
    { "body": "1. [ ] one\n2) [X] two\n* [ ] three\n+ [ ] four", "index": 3, "checked": true, "expected": "1. [ ] one\n2) [X] two\n* [ ] three\n+ [x] four" },
    { "body": "list:\n- [ ] first\n  - [ ] nested\n\t- [ ] tabbed", "index": 1, "checked": true, "expected": "list:\n- [ ] first\n  - [x] nested\n\t- [ ] tabbed" },
    { "body": "list:\n- [ ] first\n  - [ ] nested\n\t- [ ] tabbed", "index": 2, "checked": true, "expected": "list:\n- [ ] first\n  - [ ] nested\n\t- [x] tabbed" },
    { "body": "> - [ ] quoted\n> > - [x] deep", "index": 0, "checked": true, "expected": "> - [x] quoted\n> > - [x] deep" },
    { "body": "> - [ ] quoted\n> > - [x] deep", "index": 1, "checked": false, "expected": "> - [ ] quoted\n> > - [ ] deep" },
    { "body": "```\n- [ ] in code\n```\n- [ ] real", "index": 0, "checked": true, "expected": "```\n- [ ] in code\n```\n- [x] real" },
    { "body": "```\n- [ ] in code\n```\n- [ ] real", "index": 1, "checked": true, "error": "task_item_stale" },
    { "body": "~~~\n- [ ] in code\n~~~\n- [ ] real", "index": 0, "checked": true, "expected": "~~~\n- [ ] in code\n~~~\n- [x] real" },
    { "body": "```\n- [ ] never closed", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "- [ ]\n- [ ] \n- [ ]text\n-[ ] glued\n- [] empty\n- [y] other\n- [ ]  \t", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "- [ ]\n- [ ] real", "index": 0, "checked": true, "expected": "- [ ]\n- [x] real" },
    { "body": "-  [ ] two spaces", "index": 0, "checked": true, "expected": "-  [x] two spaces" },
    { "body": "-\t[ ] tab gap", "index": 0, "checked": true, "expected": "-\t[x] tab gap" },
    { "body": "123456789. [ ] nine digits", "index": 0, "checked": true, "expected": "123456789. [x] nine digits" },
    { "body": "1234567890. [ ] ten digits", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "1.[ ] glued", "index": 0, "checked": true, "error": "task_item_stale" },
    { "body": "Привет, ёж\n- [ ] задача", "index": 0, "checked": true, "expected": "Привет, ёж\n- [x] задача" },
    { "body": "- [ ] a\r\n- [ ] b\r\n", "index": 1, "checked": true, "expected": "- [ ] a\r\n- [x] b\r\n" },
    { "body": "text - [ ] not at the start", "index": 0, "checked": true, "error": "task_item_stale" }
  ]
}

    { "id": "c8e04b17-9a5d-4c32-b6f1-52d7a83e0c94", "picked": null, "expected": "pink" },
    { "id": "1d6f8a3b-2e47-4b90-9c5a-8f0e7d34b261", "picked": null, "expected": "teal" },
    { "id": "e5a79c04-6d18-4a2f-b3e0-94c1f5d72a86", "picked": null, "expected": "teal" },

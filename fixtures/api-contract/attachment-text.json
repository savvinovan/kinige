{
  "rule": "How Rust counts and normalizes the details of an attachment (slice 7b). A name is the typed stem: Rust trims it, refuses a control character (C0, DEL, C1), a path separator and a bidi override, appends the extension of the original file name (the text after its last dot, when something stands before the dot) and counts the whole in UTF-8 bytes, at most 255. An empty stem and a stem that gives the original name again are `null` (the original). A description is normalized first: CRLF and a lone CR become LF, a TAB becomes one space, the ends are trimmed; a control character left (C0 other than LF, DEL, C1) is refused; then the length is counted in Unicode scalar values, at most 1,024; empty is `null`. `expect` is the result, `null` for none, or `error` for `attachment_details_invalid`. A lone surrogate cannot reach Rust as a string (the IPC layer refuses it), so it is not in this file: the mock refuses it and a vitest test says so.",
  "rust": "kinige_domain::attachment::{normalize_name, normalize_description}",
  "mock": "web/src/api/mockDetails.ts normalizeName, normalizeDescription",
  "names": [
    { "name": "a stem keeps the original extension", "stem": "beach", "original": "IMG_0001.jpg", "expect": "beach.jpg" },
    { "name": "the ends are trimmed, a no-break space included", "stem": "  beach  ", "original": "IMG_0001.jpg", "expect": "beach.jpg" },
    { "name": "a dot in the stem is only a dot", "stem": "my.photo", "original": "a.JPG", "expect": "my.photo.JPG" },
    { "name": "Cyrillic and a space", "stem": "Пляж в июле", "original": "IMG_0001.jpg", "expect": "Пляж в июле.jpg" },
    { "name": "empty is the original", "stem": "", "original": "IMG_0001.jpg", "expect": null },
    { "name": "blank is the original", "stem": "   ", "original": "IMG_0001.jpg", "expect": null },
    { "name": "the original again is the original", "stem": "IMG_0001", "original": "IMG_0001.jpg", "expect": null },
    { "name": "a file with no extension has no suffix", "stem": "notes", "original": "README", "expect": "notes" },
    { "name": "a dot file has no extension", "stem": "x", "original": ".bashrc", "expect": "x" },
    { "name": "a dot would give an extension-less file one", "stem": "README.doc", "original": "README", "error": true },
    { "name": "a lone dot is not a name", "stem": ".", "original": "README", "error": true },
    { "name": "a slash", "stem": "a/b", "original": "x.jpg", "error": true },
    { "name": "a backslash", "stem": "a\\b", "original": "x.jpg", "error": true },
    { "name": "NUL", "stem": "a\u0000b", "original": "x.jpg", "error": true },
    { "name": "ESC", "stem": "a\u001bb", "original": "x.jpg", "error": true },
    { "name": "DEL", "stem": "a\u007fb", "original": "x.jpg", "error": true },
    { "name": "a C1 control", "stem": "a\u0085b", "original": "x.jpg", "error": true },
    { "name": "a line feed", "stem": "a\nb", "original": "x.jpg", "error": true },
    { "name": "a bidi override, U+202E", "stem": ["evil", { "cp": 8238 }, "gpj"], "original": "x.jpg", "error": true },
    { "name": "a bidi isolate, U+2066", "stem": ["a", { "cp": 8294 }, "b"], "original": "x.jpg", "error": true },
    { "name": "254 bytes with the extension", "stem": [["é", 125]], "original": "x.jpg", "expect": [["é", 125], ".jpg"] },
    { "name": "exactly 255 bytes with the extension", "stem": [["é", 125], "a"], "original": "x.jpg", "expect": [["é", 125], "a.jpg"] },
    { "name": "one byte over", "stem": [["é", 125], "aa"], "original": "x.jpg", "error": true },
    { "name": "a two-byte character over the limit", "stem": [["é", 126]], "original": "x.jpg", "error": true }
  ],
  "descriptions": [
    { "name": "plain text", "text": "Beach, July", "expect": "Beach, July" },
    { "name": "CRLF, a lone CR and LF are LF", "text": "a\r\nb\rc\nd", "expect": "a\nb\nc\nd" },
    { "name": "a TAB is one space", "text": "a\tb", "expect": "a b" },
    { "name": "the ends are trimmed", "text": "  \n hi \n ", "expect": "hi" },
    { "name": "empty is none", "text": "", "expect": null },
    { "name": "blank is none", "text": " \t\r\n ", "expect": null },
    { "name": "1,024 astral characters, 4,096 bytes", "text": [["😀", 1024]], "expect": [["😀", 1024]] },
    { "name": "1,025 astral characters", "text": [["😀", 1025]], "error": true },
    { "name": "1,024 letters", "text": [["a", 1024]], "expect": [["a", 1024]] },
    { "name": "1,025 letters", "text": [["a", 1025]], "error": true },
    { "name": "the count is taken after CRLF became LF", "text": [["a\r\n", 511], "a"], "expect": [["a\n", 511], "a"] },
    { "name": "NUL", "text": "a\u0000b", "error": true },
    { "name": "ESC", "text": "a\u001b[31m", "error": true },
    { "name": "DEL", "text": "a\u007fb", "error": true },
    { "name": "a backspace", "text": "a\u0008b", "error": true },
    { "name": "a C1 control inside", "text": "a\u0085b", "error": true },
    { "name": "Markdown and HTML are plain text", "text": "# not a heading <b>x</b> [y](z)", "expect": "# not a heading <b>x</b> [y](z)" }
  ]
}

{
  "rule": "Tags of an entry: `#` plus letters, digits and `_` (not digits only, at most 64 characters), lower case, no repeats, in order of first appearance. Not tags: code, links, HTML tags, bare addresses, `#` after a letter, digit, `_`, `#`, `&` or `\\`.",
  "rust": "kinige_domain::tags::parse_tags",
  "mock": "web/src/api/mockTags.ts mockTags",
  "cases": [
    { "body": "#tag", "expected": ["tag"] },
    { "body": "#Tag and #TAG and #tag", "expected": ["tag"] },
    { "body": "text #one, #two.", "expected": ["one", "two"] },
    { "body": "(#in_parens) and «#quotes» and \"#plain\"", "expected": ["in_parens", "quotes", "plain"] },
    { "body": "#идея #Работа #日本語!", "expected": ["идея", "работа", "日本語"] },
    { "body": "task #1 and #2024 and #1a and #12_", "expected": ["1a", "12_"] },
    { "body": "#_ #__", "expected": ["_", "__"] },
    { "body": "a#b x_#y 7#z ##double", "expected": [] },
    { "body": "a #b", "expected": ["b"] },
    { "body": "#tag1#tag2", "expected": ["tag1"] },
    { "body": "&#38; and \\#escaped", "expected": [] },
    { "body": "# Heading\n## Second", "expected": [] },
    { "body": "#tag\n###", "expected": ["tag"] },
    { "body": "# #  #", "expected": [] },
    { "body": "#", "expected": [] },
    { "body": "", "expected": [] },
    { "body": "before\n```\n#in_block\n```\nafter #outside", "expected": ["outside"] },
    { "body": "~~~sh\n#no\n~~~\n#yes", "expected": ["yes"] },
    { "body": "```\n#until_the_end", "expected": [] },
    { "body": "   ```\n#indented_fence\n   ```\n#out", "expected": ["out"] },
    { "body": "````\n```\n#still_code\n````\n#out", "expected": ["out"] },
    { "body": "`#in_code` and #out", "expected": ["out"] },
    { "body": "``code with ` and #inside`` #out", "expected": ["out"] },
    { "body": "`` #x ` `` #y", "expected": ["y"] },
    { "body": "unclosed `quote #tag", "expected": ["tag"] },
    { "body": "[text #in_link](https://x.y/#anchor) #outside", "expected": ["outside"] },
    { "body": "<https://x.y/#a> and <b class=\"#c\"> #d", "expected": ["d"] },
    { "body": "<b>#x</b>", "expected": ["x"] },
    { "body": "1 < 2 and #x > 0", "expected": ["x"] },
    { "body": "see https://x.y/page#anchor #tag", "expected": ["tag"] },
    { "body": "www.site.ru/#a mailto:a@b.c#d #e", "expected": ["e"] },
    { "body": "- [ ] do #thing\n- [x] #done", "expected": ["thing", "done"] },
    { "body": "[ ] #box [x] #checked", "expected": ["box", "checked"] },
    { "body": "[note] #after [a](b #inside)", "expected": ["after"] },
    { "body": "#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa #ok", "expected": ["ok"] },
    { "body": "#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "expected": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"] },
    { "body": "windows\r\n#crlf\r\n", "expected": ["crlf"] }
  ]
}
